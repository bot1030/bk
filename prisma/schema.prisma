generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  discordId      String        @unique
  username       String?
  coins          Int           @default(0)
  eventCoins     Int           @default(0)
  jkBalance      Int           @default(0)
  lastDaily      DateTime?
  lastFish       DateTime?
  selectedRod    String        @default("basic")
  ownedRods      Json          @default("[\"basic\"]")
  fishingCount   Int           @default(0)
  coinflipPlayed Int           @default(0)
  slotsPlayed    Int           @default(0)
  minesPlayed    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  minesGames     MinesGame[]
  pendingJkConversions PendingJkConversion[]
  theftAttemptsAsThief TheftAttempt[] @relation("TheftThief")
  theftAttemptsAsVictim TheftAttempt[] @relation("TheftVictim")
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  currency      String
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reason        String?
  createdAt     DateTime @default(now())
}

model MinesGame {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId       String?
  channelId       String?
  bet             Int
  normalCoinStake Int      @default(0)
  eventCoinStake  Int      @default(0)
  mines           Int
  board           Json
  revealed        Json     @default("[]")
  status          String   @default("ACTIVE")
  payout          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LeaderboardCache {
  id        Int      @id @default(1)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuildConfig {
  id                  String   @id @default(cuid())
  guildId             String   @unique
  bigWinChannelId     String?
  bigWinCoinThreshold Int      @default(50000)
  bigWinJkThreshold   Int      @default(50)
  commentChannelId    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PendingJkConversion {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalCoinAmount Int
  coinAmount         Int
  availableAt        DateTime
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TheftAttempt {
  id        String   @id @default(cuid())
  thiefId   String
  thief     User     @relation("TheftThief", fields: [thiefId], references: [id], onDelete: Cascade)
  victimId  String
  victim    User     @relation("TheftVictim", fields: [victimId], references: [id], onDelete: Cascade)
  status    String
  amount    Int      @default(0)
  createdAt DateTime @default(now())
}

model AdminWarningLog {
  id                        String   @id @default(cuid())
  guildId                   String?
  targetDiscordId           String
  alertType                 String
  dailyClaims               Int      @default(0)
  gameTransactions          Int      @default(0)
  coinReductionTransactions Int      @default(0)
  targetCoins               Int      @default(0)
  reason                    String?
  createdAt                 DateTime @default(now())

  @@index([targetDiscordId, alertType, createdAt])
}

model DoneRatingRequest {
  id                String   @id @default(cuid())
  guildId           String
  sourceChannelId   String
  sourceMessageId   String?
  commentChannelId  String
  createdByDiscordId String
  reviewerDiscordId String?
  rating            Int?
  comment           String?
  status            String   @default("PENDING")
  expiresAt         DateTime
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([guildId, status, expiresAt])
}

model RedPacket {
  id               String   @id @default(cuid())
  guildId          String
  channelId        String
  messageId        String?
  creatorDiscordId String
  currency         String
  totalAmount      Int
  remainingAmount  Int
  playerLimit      Int
  claimedCount     Int      @default(0)
  bestLuckUserId   String?
  bestLuckAmount   Int      @default(0)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  claims           RedPacketClaim[]

  @@index([guildId, status, createdAt])
}

model RedPacketClaim {
  id             String   @id @default(cuid())
  redPacketId    String
  redPacket      RedPacket @relation(fields: [redPacketId], references: [id], onDelete: Cascade)
  discordId      String
  username       String?
  amount         Int
  currency       String
  createdAt      DateTime @default(now())

  @@unique([redPacketId, discordId])
  @@index([discordId, createdAt])
}
